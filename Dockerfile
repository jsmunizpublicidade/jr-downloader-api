FROM node:20-bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive \
    NODE_ENV=production \
    PORT=7860 \
    YT_DLP_PATH=/usr/local/bin/yt-dlp \
    CHROME_PATH=/usr/bin/chromium \
    JR_LINK_TTL=3600 \
    JR_CONVERT_PER_MIN=20

RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates ffmpeg python3 python3-pip chromium fonts-liberation \
    && rm -rf /var/lib/apt/lists/*
RUN pip3 install --no-cache-dir --break-system-packages -U yt-dlp

WORKDIR /app
RUN mkdir -p dist/server/resolve
RUN \
    printf '%s' '' > /tmp/jr-api.tar.gz.b64 && \
    printf '%s' '' >> /tmp/jr-api.tar.gz.b64 && \
    printf '%s' '' >> /tmp/jr-api.tar.gz.b64 && \
    printf '%s' '' >> /tmp/jr-api.tar.gz.b64 && \
    base64 -d /tmp/jr-api.tar.gz.b64 > /tmp/jr-api.tar.gz && \
    tar -xzf /tmp/jr-api.tar.gz -C /app && \
    rm -f /tmp/jr-api.tar.gz.b64 /tmp/jr-api.tar.gz
RUN npm ci --omit=dev

EXPOSE 7860
CMD ["node", "dist/server/index.js"]
