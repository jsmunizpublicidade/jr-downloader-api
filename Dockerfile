FROM node:20-bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive 
    NODE_ENV=production 
    PORT=7860 
    YT_DLP_PATH=/usr/local/bin/yt-dlp 
    CHROME_PATH=/usr/bin/chromium 
    JR_SECRET=e614d198697b810c2135bc7e6f1e76baec97720db728d7bd 
    JR_LINK_TTL=3600 
    JR_CONVERT_PER_MIN=20

RUN apt-get update && apt-get install -y --no-install-recommends 
      ca-certificates ffmpeg python3 python3-pip 
    && rm -rf /var/lib/apt/lists/*
RUN pip3 install --no-cache-dir --break-system-packages -U yt-dlp

WORKDIR /app
RUN mkdir -p dist/server/resolve
RUN     echo  | base64 -d > package.json && 
    echo  | base64 -d > package-lock.json && 
    echo  | base64 -d > dist/server/config.js && 
    echo  | base64 -d > dist/server/index.js && 
    echo  | base64 -d > dist/server/instagram-url.js && 
    echo  | base64 -d > dist/server/link.js && 
    echo  | base64 -d > dist/server/media.js && 
    echo  | base64 -d > dist/server/rate-limit.js && 
    echo  | base64 -d > dist/server/sign.js && 
    echo  | base64 -d > dist/server/resolve\browser.js && 
    echo  | base64 -d > dist/server/resolve\facebook.js && 
    echo  | base64 -d > dist/server/resolve\http.js && 
    echo  | base64 -d > dist/server/resolve\index.js && 
    echo  | base64 -d > dist/server/resolve\parse-page.js && 
    echo ZXhwb3J0IHt9OwovLyMgc291cmNlTWFwcGluZ1VSTD10eXBlcy5qcy5tYXA= | base64 -d > dist/server/resolve\types.js && 
    echo  | base64 -d > dist/server/resolve\ytdlp-media.js && 
    echo  | base64 -d > dist/server/resolve\ytdlp.js

RUN npm ci --omit=dev

EXPOSE 7860
CMD ["node", "dist/server/index.js"]

